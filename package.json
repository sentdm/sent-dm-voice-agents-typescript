{
  "name": "@sentdm/voice-agents",
  "version": "0.0.0",
  "description": "Sent Voice Agents for TypeScript: an AI agent that takes and places phone calls through Sent",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentdm/sent-dm-voice-agents-typescript.git"
  },
  "homepage": "https://docs.sent.dm",
  "keywords": [
    "sent",
    "voice",
    "agents",
    "calls",
    "websocket"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./frames": {
      "types": "./dist/frames.d.ts",
      "default": "./dist/frames.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --check .",
    "fix": "prettier --write .",
    "conformance": "node dist/conformance.js"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
